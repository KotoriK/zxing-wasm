{
  "name": "zxing-wasm",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./wasm": {
      "default": "./wasm-out/reader/zxing_reader.wasm"
    },
    "./wasm/reader": {
      "default": "./wasm-out/reader/zxing_reader.wasm"
    },
    "./wasm/writer": {
      "default": "./wasm-out/writer/zxing_writer.wasm"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build:wasm": "bash scripts/build.sh",
    "clean:js": "cmake -E rm -rf dist",
    "build:js": "pnpm run clean:js && tsc",
    "build": "pnpm run build:wasm && pnpm run build:js"
  },
  "keywords": [
    "zxing",
    "wasm",
    "barcode",
    "qrcode"
  ],
  "author": {
    "name": "KotoriK",
    "website": "https://github.com/KotoriK"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/dom-mediacapture-transform": "^0.1.10",
    "@webgpu/types": "^0.1.54",
    "typescript": "5.7.3",
    "vite": "^6.1.1",
    "vite-plugin-dts": "^4.5.0",
    "vite-plugin-wasm": "^3.4.1"
  },
  "files": [
    "dist",
    "wasm-out"
  ]
}
